# Zeitzone des Pi-hole-Containers
TZ=Europe/Berlin

# Host-Ports. DNS muss normalerweise 53/tcp+udp bleiben.
PIHOLE_DNS_PORT=53
PIHOLE_HTTP_PORT=8080
PIHOLE_HTTPS_PORT=8443

# Optional: Host-IP, an die die Ports gebunden werden.
# Leer = alle Host-Interfaces. Für eine einzelne LAN-IP z. B. 192.168.178.10
PIHOLE_BIND_IP=0.0.0.0

# DNS-Verhalten
PIHOLE_DNSSEC=false
PIHOLE_QUERY_LOGGING=true

# Unbound
UNBOUND_THREADS=1
UNBOUND_VERBOSITY=0
